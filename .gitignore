*.xcworkspace
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.perspectivev3
!default.perspectivev3
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Mac
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Python (ComfyUI MCP tooling)
__pycache__/
*.pyc

# AI-generated outputs (regenerable via ComfyUI MCP)
Art/generated/

# ---------------------------------------------------------------------------
# Pesados, gerados ou inseguros para o GitHub
# ver Docs/BACKLOG_Tecnico.md -> ORG-002, ORG-010, IP-004
# ---------------------------------------------------------------------------

# IP: estudo/referencia e derivados de obra de terceiros
Art/Megaman.obj
Art/Megaman.stl

# Malhas de troca e compactados: sempre pesados, e sempre derivados de fonte DCC
*.stl
*.obj
*.fbx
*.glb
*.zip
*.blend1

# PNG dentro do Content = fonte importada; o que vale e o .uasset
Content/**/*.png

# Capturas do editor e logs
Captures/
*.log

# (o plugin de terceiros UnrealMCP foi REMOVIDO do projeto: a MCP oficial da engine 5.8
#  e a que roda. Ver Docs/AssetPipeline3D.md)

# Backup local e ferramentas auxiliares (nunca versionar)
_backup/
.tools/
